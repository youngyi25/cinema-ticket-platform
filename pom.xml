<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.xinghe</groupId>
    <artifactId>cinema-parent</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>cinema-parent</name>
    <description>星河影城票务平台 - 核心模块实现</description>

    <modules>
        <module>cinema-common</module>
        <module>cinema-cinema</module>
        <module>cinema-movie</module>
        <module>cinema-schedule</module>
        <module>cinema-ticket</module>
        <module>cinema-payment</module>
        <module>cinema-member</module>
        <module>cinema-order</module>
        <module>cinema-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <spring-boot.version>3.2.6</spring-boot.version>
        <mybatis-plus.version>3.5.7</mybatis-plus.version>
        <redisson.version>3.24.3</redisson.version>
        <lombok.version>1.18.32</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
                <version>${mybatis-plus.version}</version>
            </dependency>
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>
            <dependency>
                <groupId>org.projectlombok</groupId>
                <artifactId>lombok</artifactId>
                <version>${lombok.version}</version>
            </dependency>

            <!-- 内部模块统一版本 -->
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-cinema</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-movie</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-schedule</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-ticket</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-payment</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-member</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.xinghe</groupId>
                <artifactId>cinema-order</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <encoding>UTF-8</encoding>
                        <!-- Spring MVC 需要保留方法参数名，否则 @PathVariable/@RequestParam 会报
                             "parameter name information not available"（等价于 spring-boot-starter-parent 的默认配置） -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.2.5</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
